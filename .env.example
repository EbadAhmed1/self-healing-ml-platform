# ═══════════════════════════════════════════════════════════════════════════
# .env.example — Copy to .env and fill in your actual credentials.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database Connection ──────────────────────────────────────────────────
# PostgreSQL DSN (Supabase in production, or local PostgreSQL for dev).
# Note: Escape '@' in passwords as '%40' for SQLAlchemy / Alembic DSN parsing.
DATABASE_URL=postgresql://postgres.tpmzoopvmxvjzfrkyomg:your_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── LLM / Diagnosis Agent ───────────────────────────────────────────────
# API key and model for Groq LLM reasoning layer used by the /agent/diagnose loop.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Alerting & Notifications ────────────────────────────────────────────
# Slack incoming webhook URL for automated drift and incident alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK/URL

# ── Hugging Face Model Registry ─────────────────────────────────────────
# Access token and repository ID for model artifact storage & versioning.
HF_HUB_TOKEN=hf_your_huggingface_token_here
HF_REPO_ID=your-username/self-healing-ml-platform

# ── Local & Server Application Settings ──────────────────────────────────
MODEL_REGISTRY_PATH=./models/artifacts
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
