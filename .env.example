# ═══════════════════════════════════════════════════════════════════════════
# .env.example — copy to .env and fill in real values
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────
# Full DSN for SQLAlchemy. For local dev this points to the Docker Compose
# Postgres instance defined in docker-compose.yml.
DATABASE_URL=postgresql://mluser:mlpassword@localhost:5432/mlplatform

# ── Model registry ───────────────────────────────────────────────────────
# Local filesystem path where serialised model artifacts (.pkl / .joblib)
# are stored. This directory is gitignored; only training code is committed.
MODEL_REGISTRY_PATH=./models/artifacts

# ── Logging ──────────────────────────────────────────────────────────────
# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── FastAPI ───────────────────────────────────────────────────────────────
# Host and port the uvicorn server binds to in development.
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit dashboard ───────────────────────────────────────────────────
# The Streamlit app fetches live metrics from the FastAPI service.
API_BASE_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════════════════════
# Variables below are unused in Phase 0 — placeholders only.
# ═══════════════════════════════════════════════════════════════════════════

# ── LLM / Diagnosis agent (used in Phase 5) ──────────────────────────────
# API key and model for Groq LLM reasoning layer used by the /agent diagnosis loop.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Alerting (used in Phase 3) ────────────────────────────────────────────
# Incoming webhook URL for Slack alerts from drift-detection jobs.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Hugging Face Hub (used in Phase 4) ───────────────────────────────────
# Token for pushing / pulling models from the HF Hub model registry.
# HF_HUB_TOKEN=hf_...

# ── Supabase (used in Phase 5 — production DB swap) ──────────────────────
# Replace DATABASE_URL with this DSN when deploying to Supabase.
# SUPABASE_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# SUPABASE_ANON_KEY=eyJ...
